{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "if": "Bash(pytest*)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/predict-gate"},
        {"type": "command", "if": "Bash(python -m pytest*)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/predict-gate"},
        {"type": "command", "if": "Bash(python3 -m pytest*)", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/predict-gate"}
      ]}
    ],
    "PostToolUse": [
      {"matcher": "AskUserQuestion", "hooks": [
        {"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/record-move"}
      ]}
    ]
  }
}
