{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        {"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/edit-gate", "timeout": 30}
      ]}
    ],
    "PostToolUse": [
      {"matcher": "AskUserQuestion", "hooks": [
        {"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/record-move"}
      ]}
    ],
    "Stop": [
      {"hooks": [
        {"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/scripts/stop-check"}
      ]}
    ]
  }
}
