#!/usr/bin/env python3
"""PostToolUse on AskUserQuestion: record the answer to a Fathom move.

Claude Code passes the user's choice in tool_response.answers, a map from the
question text to the chosen option label. The question's header says which
move the answer belongs to.
"""
import sys

sys.dont_write_bytecode = True  # the plugin folder is replaced on update; keep it clean

from fathom_runtime import debug_dump, load_state, read_input, record_event, save_state

MOVES = {"Approach": "approach", "Check": "check"}


def main() -> None:
    hook_input = read_input()
    debug_dump("record-move", hook_input)
    questions = (hook_input.get("tool_input") or {}).get("questions") or []
    question = next((q for q in questions if isinstance(q, dict) and q.get("header") in MOVES), None)
    if question is None:
        return
    move = MOVES[question["header"]]

    session = hook_input.get("session_id", "")
    state = load_state(session)
    goal = (state.get("classified") or {}).get("goal")
    response = hook_input.get("tool_response")
    answers = response.get("answers") if isinstance(response, dict) else None
    label = answers.get(question.get("question")) if isinstance(answers, dict) else None
    if not isinstance(label, str):
        record_event(move, "unanswered", goal=goal)
        return

    if label.strip().lower() == "skip":
        record_event(move, "skipped", goal=goal)
        if move == "check":
            state["scored"] = True
    else:
        record_event(move, "answered", goal=goal, label=label)
    state["answer"] = label
    save_state(session, state)


if __name__ == "__main__":
    main()
